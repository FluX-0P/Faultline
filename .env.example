# LLM used by understand, scan and plan. Get a free key at https://aistudio.google.com
FAULTLINE_LLM_API_KEY=

# Optional: any OpenAI-compatible endpoint. Leave these unset for Google Gemini with gemini-3.6-flash.
# On Gemini's free tier, gemini-3.5-flash-lite allows far more requests per day if you run out.
# FAULTLINE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# FAULTLINE_LLM_MODEL=gemini-3.6-flash

# Example: Groq instead of Gemini (key from https://console.groq.com)
# FAULTLINE_LLM_BASE_URL=https://api.groq.com/openai/v1
# FAULTLINE_LLM_MODEL=llama-3.3-70b-versatile
